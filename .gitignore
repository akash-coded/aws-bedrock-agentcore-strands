# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Environment & credentials  — never commit these
.env
.env.local
*.pem
credentials
*credentials*.csv

# AgentCore / CDK build output
.agentcore/
.bedrock_agentcore.yaml
cdk.out/
node_modules/
package-lock.json

# Local state
*.sqlite
*.log
.cli/

# OS
.DS_Store
Thumbs.db

# L.A.B. Simulator — local progress only
labs/.progress.json
labs/catalog/**/_starter_probe.py

# Site build output and packaged relay template
site/_site/
site/contact-relay/.packaged.yaml
site/contact-relay/.aws-sam/
site/__pycache__/
site/content/roles/_src/__pycache__/

# The Desktop app's preview-server list and its worktrees stay on the machine they were made on
.claude/launch.json
.claude/worktrees/
# Skills linked into the repository by a cloud session's setup point outside it; only the repository's own skill is kept
/.claude/skills/*
!/.claude/skills/manual-diagrams/
