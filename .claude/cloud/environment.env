# Paste these lines into the cloud environment's "Environment variables" box (claude.ai/code, the cloud
# icon above the message box, the environment's settings). .env format: one KEY=value per line.
# Nothing here is secret, and nothing secret may go here: anyone who uses the environment can read it.

# Headless Chrome for the site's check tools (installed by .claude/cloud/setup.sh)
CHROME=/usr/local/bin/google-chrome
# Dates in the build (freshness warnings, "checked on" dates) follow the owner's clock
TZ=Asia/Kolkata
PYTHONDONTWRITEBYTECODE=1
# The site's tests and screenshot runs take minutes: 5 minutes by default, up to 30
BASH_DEFAULT_TIMEOUT_MS=300000
BASH_MAX_TIMEOUT_MS=1800000
# The owner works at the highest effort and never lower (use xhigh if max is not offered for the model)
CLAUDE_CODE_EFFORT_LEVEL=max
# The model the owner chose on 2 October 2026; the model picker in a session still overrides it
ANTHROPIC_MODEL=claude-opus-5-5
# Lets a session run agent teams as well as subagents
CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1
